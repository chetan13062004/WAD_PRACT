<!DOCTYPE html>
<html>
<head>
    <title>Song List</title>
    <style>
        table {
            width: 80%;
            margin: 20px auto;
            border-collapse: collapse;
        }
        th, td {
            padding: 8px 15px;
            border: 1px solid #000;
            text-align: center;
        }
    </style>
</head>
<body>
    <h2 style="text-align:center;">Total Songs: <%= count %></h2>
    <table>
        <thead>
            <tr>
                <th>Songname</th>
                <th>Film</th>
                <th>Music Director</th>
                <th>Singer</th>
                <th>Actor</th>
                <th>Actress</th>
            </tr>
        </thead>
        <tbody>
            <% songs.forEach(song => { %>
                <tr>
                    <td><%= song.Songname %></td>
                    <td><%= song.Film %></td>
                    <td><%= song.Music_director %></td>
                    <td><%= song.Singer %></td>
                    <td><%= song.Actor || '-' %></td>
                    <td><%= song.Actress || '-' %></td>
                </tr>
            <% }) %>
        </tbody>
    </table>
</body>
</html>
