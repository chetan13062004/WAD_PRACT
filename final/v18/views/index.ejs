<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <style>
        table{
            width: 100%;
            height: auto;
        }
    </style>
</head>
<body>
    <h1>All Songs (Total : <%= count %>)</h1>

    <table>
        <tr>
            <th>Song name</th>
            <th>Film Name</th>
            <th>Music Director</th>
            <th>Singer</th>
            <th>Actor</th>
            <th>Actress</th>
        </tr>

        <% songs.forEach(song => { %>
            <tr>
              <td><%= song.songname %></td>
              <td><%= song.film %></td>
              <td><%= song.musicdirector %></td>
              <td><%= song.singer %></td>
              <td><%= song.actor || "-" %></td>
              <td><%= song.actress || "-" %></td>
            </tr>
          <% }) %>
          
    </table>
</body>
</html>