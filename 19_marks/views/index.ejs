<!DOCTYPE html>
<html>
<head>
  <title>Student Marks</title>
  <style>
    table, th, td { border: 1px solid black; border-collapse: collapse; padding: 8px; }
  </style>
</head>
<body>
  <h1>Student Records (Total: <%= count %>)</h1>
  <table>
    <tr>
      <th>Name</th><th>Roll No</th><th>WAD</th><th>CC</th><th>DSBDA</th><th>CNS</th><th>AI</th>
    </tr>
    <% stud.forEach(s => { %>
    <tr>
      <td><%= s.Name %></td>
      <td><%= s.Roll_No %></td>
      <td><%= s.WAD_Marks %></td>
      <td><%= s.CC_Marks %></td>
      <td><%= s.DSBDA_Marks %></td>
      <td><%= s.CNS_Marks %></td>
      <td><%= s.AI_Marks %></td>
    </tr>
    <% }) %>
  </table>
</body>
</html>
